node_modules/
.DS_Store

# Legacy subdirectories (pre-flatten)
claude-code-kickstart/

# Private session files
state/
/context/
plugins/*/context/

# Build artifacts (committed to npm, not git)
hooks/dist/

# Coverage artifacts
coverage/
# Test fixtures may contain pre-baked coverage JSON — unignore them
!tests/fixtures/**/coverage/
!tests/fixtures/**/coverage/**

# Animation assets
animation/
*.gif

# Governance templates are tracked
# (Root CLAUDE.md is also tracked — it's the project governance file)

# .claude/ — governance files committed (agents, hooks, settings.json)
# Runtime state and personal config stay local:
.claude/.DS_Store
.claude/agent-memory/
.claude/settings.local.json
.claude/worktrees/
.claude/**/*.log
.claude/tmp/
.claude/cache/
.claude/state/
.claude/scheduled_tasks.lock

# Internal planning documents (STATE.md is committed; everything else is local)
.planning/phases/
.planning/PROJECT.md
.planning/config.json
.planning/research/
# pause-work resume pointers are session-local — never commit them
/.continue-here.md
/.planning/.continue-here.md
# checkpoint/handoff runtime state — tests already treat these as RUNTIME_ARTIFACT_EXCEPTIONS
# ("not shipped as tracked repo files"); keep them session-local like state/
/.planning/HANDOFF.json
/.planning/HANDOFF.md
/.planning/CHECKPOINT.json
# Stop-hook deferral sentinel — records "commit deferred pending review" intent
# for one session; never a tracked artifact.
/.planning/.review-pending
reports/
analysis/

# Installed skills (other platforms)
.github/agents/gsd-*
.github/skills/gsd-*
.github/get-shit-done/*
.github/skills/get-shit-done
.github/copilot-instructions.md
.bg-shell/

# Misc
TO-DOS.md
/research.claude/
commands.html
# Generated dashboard artifact (external status tool; regenerate on demand)
/STATUS.md

# Layer 2 fixture tooling (regenerate on demand)
scripts/build-layer1-fixture.cjs
.extraction-staging/
Petes-Get-Shit-Done-Coding-Automation/
.planning/agent-health.log
